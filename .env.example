# 可选环境变量；模型接口也可在 /admin 管理后台配置。
# 这是模板文件，请勿写入真实密钥——真实配置放在未入库的同级 .env 中。

PORT=3000

# 部署在反向代理（Nginx）之后时必须设为 1：信任代理转发来的 X-Forwarded-For，
# 否则 express-rate-limit 无法正确识别客户端 IP，会抛 ERR_ERL_UNEXPECTED_X_FORWARDED_FOR。
TRUST_PROXY="1"

# 上游生图接口：留空时使用代码内的默认 endpoint；生产建议显式指定自有地址。
PIAO_BASE_URL=""
PIAO_API_KEY=""
XIAOYI_BASE_URL=""
XIAOYI_API_KEY=""
XIAOYI_IMAGE_MODEL="gpt-image-2"

# 初始管理员口令，长度 ≥ 8 才会生效。
# 留空则使用公开在 README 中的初始口令，生产环境务必设置。
ADMIN_INITIAL_PASSWORD=""

# 画布 iframe 与服务端代理之间的令牌。
# 留空时每次进程启动随机生成；多实例或需跨重启保持会话时必须统一设置。
CANVAS_PROXY_TOKEN=""

# 留空时自动生成新的签名密钥并保存到 data/，每个部署独立。
ADMIN_TOKEN_SECRET=""
USER_SESSION_SECRET=""
